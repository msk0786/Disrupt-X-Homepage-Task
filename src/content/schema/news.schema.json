{
  "$id": "news.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "News: latest press releases",
  "type": "object",
  "required": ["eyebrow", "title", "accent", "lead", "readLabel", "viewAll", "items"],
  "additionalProperties": false,
  "properties": {
    "eyebrow": { "$ref": "shared.schema.json#/definitions/text" },
    "title": { "$ref": "shared.schema.json#/definitions/text" },
    "accent": { "$ref": "shared.schema.json#/definitions/text" },
    "lead": { "$ref": "shared.schema.json#/definitions/text" },
    "readLabel": { "$ref": "shared.schema.json#/definitions/text" },
    "viewAll": { "$ref": "shared.schema.json#/definitions/link" },
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": {
        "type": "object",
        "required": ["id", "tag", "date", "dateLabel", "title", "href", "image"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "tag": { "$ref": "shared.schema.json#/definitions/text" },
          "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "dateLabel": { "$ref": "shared.schema.json#/definitions/text" },
          "title": { "$ref": "shared.schema.json#/definitions/text" },
          "href": { "$ref": "shared.schema.json#/definitions/href" },
          "image": { "$ref": "shared.schema.json#/definitions/image" }
        }
      }
    }
  }
}
