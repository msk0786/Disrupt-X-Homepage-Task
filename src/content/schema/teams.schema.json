{
  "$id": "teams.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Teams: the three audiences and their demo screens",
  "type": "object",
  "required": ["eyebrow", "title", "accent", "lead", "items"],
  "additionalProperties": false,
  "properties": {
    "eyebrow": { "$ref": "shared.schema.json#/definitions/text" },
    "title": { "$ref": "shared.schema.json#/definitions/text" },
    "accent": { "$ref": "shared.schema.json#/definitions/text" },
    "lead": { "$ref": "shared.schema.json#/definitions/text" },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "icon", "audience", "title", "accent", "lead", "points", "screen", "hint"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z-]+$" },
          "icon": { "$ref": "shared.schema.json#/definitions/icon" },
          "audience": { "$ref": "shared.schema.json#/definitions/text" },
          "title": { "$ref": "shared.schema.json#/definitions/text" },
          "accent": { "$ref": "shared.schema.json#/definitions/text" },
          "lead": { "$ref": "shared.schema.json#/definitions/text" },
          "points": { "type": "array", "minItems": 1, "items": { "$ref": "shared.schema.json#/definitions/text" } },
          "screen": { "enum": ["workOrder", "incident", "dashboard"] },
          "showApps": { "type": "boolean" },
          "photo": { "$ref": "shared.schema.json#/definitions/responsiveImage" },
          "hint": { "$ref": "shared.schema.json#/definitions/text" }
        }
      }
    }
  }
}
