{
  "$id": "story.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Story: scattered jobs that land in one inbox",
  "type": "object",
  "required": ["eyebrow", "title", "accent", "lead", "items", "labels", "inbox", "before", "after"],
  "additionalProperties": false,
  "properties": {
    "eyebrow": { "$ref": "shared.schema.json#/definitions/text" },
    "title": { "$ref": "shared.schema.json#/definitions/text" },
    "accent": { "$ref": "shared.schema.json#/definitions/text" },
    "lead": { "$ref": "shared.schema.json#/definitions/text" },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "source", "sourceLabel", "title", "meta", "result"],
        "properties": {
          "id": { "type": "string" },
          "source": { "enum": ["whatsapp", "paper", "excel"] },
          "sourceLabel": { "$ref": "shared.schema.json#/definitions/text" },
          "title": { "$ref": "shared.schema.json#/definitions/text" },
          "meta": { "$ref": "shared.schema.json#/definitions/text" },
          "time": { "type": "string" },
          "stamp": { "type": "string" },
          "row": { "type": "integer" },
          "note": { "type": "string" },
          "result": {
            "type": "object",
            "required": ["ref", "type", "title", "owner", "status", "tone", "module"],
            "additionalProperties": false,
            "properties": {
              "ref": { "type": "string" },
              "type": { "type": "string" },
              "title": { "type": "string" },
              "owner": { "type": "string" },
              "status": { "type": "string" },
              "tone": { "$ref": "shared.schema.json#/definitions/tone" },
              "module": { "type": "string" }
            }
          }
        },
        "additionalProperties": false
      }
    },
    "labels": {
      "type": "object",
      "required": ["before", "after"],
      "additionalProperties": false,
      "properties": { "before": { "type": "string" }, "after": { "type": "string" } }
    },
    "inbox": {
      "type": "object",
      "required": ["window", "title", "subtitle", "status"],
      "additionalProperties": false,
      "properties": {
        "window": { "type": "string" },
        "title": { "type": "string" },
        "subtitle": { "type": "string" },
        "status": { "type": "string" }
      }
    },
    "before": { "$ref": "#/definitions/count" },
    "after": { "$ref": "#/definitions/count" }
  },
  "definitions": {
    "count": {
      "type": "object",
      "required": ["value", "label"],
      "additionalProperties": false,
      "properties": { "value": { "type": "number" }, "label": { "type": "string" } }
    }
  }
}
